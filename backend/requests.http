### Environment variables
@baseUrl = http://localhost:3000/api
@token = YOUR_TOKEN_HERE
@adminToken = YOUR_ADMIN_TOKEN_HERE

### AUTHENTICATION

### Register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nama_lengkap": "Dimitri Athallah",
  "email": "dimitri@email.com",
  "password": "password123",
  "no_hp": "081234567890"
}

### Login User
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "thedimitris@email.com",
  "password": "password123"
}
# -> Copy token and replace YOUR_TOKEN_HERE

### Login Admin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@senada.com",
  "password": "password123"
}
# -> Copy token and replace YOUR_ADMIN_TOKEN_HERE

### STUDIOS

### Get All Studios
GET {{baseUrl}}/studios

### Get Studios with Filter (Search & Kategori)
GET {{baseUrl}}/studios?search=Sonic&sort=Terdekat

### Get Studio by ID
GET {{baseUrl}}/studios/1

### Get Studio Schedules
GET {{baseUrl}}/studios/1/schedules?tanggal=2026-10-06

### PROMOS

### Validate Promo
POST {{baseUrl}}/promos/validate
Content-Type: application/json

{
  "kode": "NADABARU"
}

### BOOKINGS

### Create Booking
POST {{baseUrl}}/bookings
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "studio_id": 1,
  "tanggal_booking": "2026-10-06",
  "jam_mulai": "13:00:00",
  "durasi": 2,
  "metode_pembayaran": "QRIS",
  "promo_kode": "NADABARU"
}

### Get User Bookings
GET {{baseUrl}}/bookings/user/2
Authorization: Bearer {{token}}


### USERS

### Get User Profile
GET {{baseUrl}}/users/2
Authorization: Bearer {{token}}


### ADMIN

### Get All Bookings
GET {{baseUrl}}/admin/bookings
Authorization: Bearer {{adminToken}}

### Approve Booking
PUT {{baseUrl}}/admin/bookings/1/approve
Authorization: Bearer {{adminToken}}

### Reject Booking
PUT {{baseUrl}}/admin/bookings/1/reject
Authorization: Bearer {{adminToken}}
